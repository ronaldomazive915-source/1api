rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'founder' ||
         request.auth.token.email == 'ronaldomazive915@gmail.com');
    }

    function isValidUser(data) {
      return data.size() >= 3 &&
             data.uid is string &&
             data.email is string &&
             data.role in ['user', 'admin', 'founder'];
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Video Sources (Rule 9, 10, 11)
    match /videoSources/{sourceId} {
      allow read: if true; // Public read for API/Playhouse
      allow write: if isAdmin();
    }

    // M3U Management
    match /m3uSources/{sourceId} {
      allow read, write: if isAdmin();
    }
    match /m3uSyncJobs/{jobId} {
      allow read, write: if isAdmin();
    }
    match /m3uSyncErrors/{errorId} {
      allow read, write: if isAdmin();
    }

    // Catalog & Content
    match /liveChannels/{channelId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Allow public read of test connection for the tool check
    match /test/connection {
      allow read: if true;
    }
  }
}
